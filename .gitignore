#   For a library or semi-app you might want to ignore these files but not a comment.
.python-version

# pipenv
#   According to the pipenv official documentation (https://pipenv.pypa.io/en/latest/technical.html),
#   this does not include Pipfile.lock, which will be treated as a project dependency file.
#Pipfile.lock

